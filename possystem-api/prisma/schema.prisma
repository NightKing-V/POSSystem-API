// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Change to "mysql" or "sqlserver" if needed
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum LocationType {
  BRANCH
  WAREHOUSE
  DOCK
}

enum POStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PaymentTerms {
  COD
  NET_15
  NET_30
  NET_60
}

enum POItemStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum InventoryTransactionType {
  RECEIVED
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  ADJUSTMENT
}

enum SupplierTransactionType {
  INVOICED
  PAYMENT_MADE
  CREDIT_NOTE
  ADJUSTMENT
}

enum CustomerTransactionType {
  CHARGED
  REPAID
  CREDIT_NOTE
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTMENT
}

enum BillStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT_ACCOUNT
  LOYALTY_POINTS
}

// -----------------------------------------------------------------------------
// USER & ACCESS CONTROL
// -----------------------------------------------------------------------------

model User {
  id         String    @id @default(uuid())
  fullname   String
  email      String    @unique
  phone      String?
  address    String?
  createdat  DateTime  @default(now())
  modifiedat DateTime  @updatedAt
  lastlogin  DateTime?

  // Relations
  owned_orgs             Org[]
  system_roles           UserSystemRole[]            @relation("UserSystemRoles")
  assigned_system_roles  UserSystemRole[]            @relation("SystemRoleAssigner")
  roles                  UserRole[]                  @relation("UserRoles")
  assigned_roles         UserRole[]                  @relation("RoleAssigner")
  locations              UserLocation[]              @relation("UserLocations")
  assigned_locations     UserLocation[]              @relation("LocationAssigner")
  stock_batches          StockBatch[]
  inventory_transactions InventoryTransaction[]
  purchase_orders        PurchaseOrder[]
  supplier_transactions  SupplierCreditTransaction[]
  customer_transactions  CustomerCreditTransaction[]
  bills                  Bill[]                      @relation("CashierBills")
  bill_payments          BillPayment[]
}

model SystemRole {
  id                 String                 @id @default(uuid())
  key                String                 @unique
  name               String
  description        String?
  is_org_template    Boolean                @default(true)
  is_org_entrypoint  Boolean                @default(false)
  is_location_scoped Boolean                @default(false)
  permissions        SystemRolePermission[]
  users              UserSystemRole[]
  org_roles          OrgRole[]
}

model OrgRole {
  id                 String              @id @default(uuid())
  org_id             String
  system_role_id     String?
  name               String
  description        String?
  is_builtin         Boolean             @default(false)
  is_entrypoint      Boolean             @default(false)
  is_location_scoped Boolean             @default(false)

  org         Org                 @relation(fields: [org_id], references: [id], onDelete: Cascade)
  system_role SystemRole?         @relation(fields: [system_role_id], references: [id])
  permissions OrgRolePermission[]
  users       UserRole[]

  @@unique([org_id, name])
  @@index([org_id])
}

model Permission {
  id           String                 @id @default(uuid())
  resource     String
  action       String
  description  String?
  system_roles SystemRolePermission[]
  org_roles    OrgRolePermission[]

  @@unique([resource, action])
}

model SystemRolePermission {
  system_role_id String
  permission_id  String
  system_role    SystemRole @relation(fields: [system_role_id], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([system_role_id, permission_id])
}

model OrgRolePermission {
  org_role_id   String
  permission_id String
  org_role      OrgRole    @relation(fields: [org_role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([org_role_id, permission_id])
}

model UserSystemRole {
  user_id        String
  system_role_id String
  assigned_at    DateTime   @default(now())
  assigned_by    String?

  user        User       @relation("UserSystemRoles", fields: [user_id], references: [id], onDelete: Cascade)
  system_role SystemRole @relation(fields: [system_role_id], references: [id], onDelete: Cascade)
  assigner    User?      @relation("SystemRoleAssigner", fields: [assigned_by], references: [id])

  @@id([user_id, system_role_id])
}

model UserRole {
  user_id     String
  role_id     String
  org_id      String
  assigned_at DateTime @default(now())
  assigned_by String?

  user     User    @relation("UserRoles", fields: [user_id], references: [id])
  role     OrgRole @relation(fields: [role_id], references: [id], onDelete: Cascade)
  org      Org     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  assigner User?   @relation("RoleAssigner", fields: [assigned_by], references: [id])

  @@id([user_id, role_id, org_id])
}

model UserLocation {
  user_id     String
  location_id String
  assigned_at DateTime @default(now())
  assigned_by String?

  user     User              @relation("UserLocations", fields: [user_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])
  assigner User?             @relation("LocationAssigner", fields: [assigned_by], references: [id])

  @@id([user_id, location_id])
}

// -----------------------------------------------------------------------------
// ORGANIZATION & BUSINESS
// -----------------------------------------------------------------------------

model Org {
  id                  String  @id @default(uuid())
  owner_id            String
  businesscategory_id String
  address             String?
  phone               String?

  owner             User             @relation(fields: [owner_id], references: [id])
  business_category BusinessCategory @relation(fields: [businesscategory_id], references: [id])

  roles             OrgRole[]
  user_roles        UserRole[]
  categories        ProductCategory[]
  brands            Brand[]
  products          Product[]
  discounts         Discount[]
  locations         InventoryLocation[]
  suppliers         Supplier[]
  purchase_orders   PurchaseOrder[]
  supplier_accounts SupplierCreditAccount[]
  supplier_txs      SupplierCreditTransaction[]
  customers         Customer[]
  customer_accounts CustomerCreditAccount[]
  customer_txs      CustomerCreditTransaction[]
  loyalty_txs       CustomerLoyaltyTransaction[]
  loyalty_config    LoyaltyProgramConfig?
  bills             Bill[]
}

model BusinessCategory {
  id                 String                    @id @default(uuid())
  type               String                    @unique
  orgs               Org[]
  category_templates ProductCategoryTemplate[]
}

model ProductCategoryTemplate {
  id                  String  @id @default(uuid())
  businesscategory_id String
  parent_id           String?
  name                String
  level               Int     @default(0)

  business_category BusinessCategory          @relation(fields: [businesscategory_id], references: [id], onDelete: Cascade)
  parent            ProductCategoryTemplate?  @relation("SubCategoryTemplates", fields: [parent_id], references: [id])
  children          ProductCategoryTemplate[] @relation("SubCategoryTemplates")
  org_categories    ProductCategory[]

  @@unique([businesscategory_id, parent_id, name])
  @@index([businesscategory_id])
}

// -----------------------------------------------------------------------------
// PRODUCT CATALOG
// -----------------------------------------------------------------------------

model ProductCategory {
  id          String  @id @default(uuid())
  org_id      String
  template_id String?
  parent_id   String?
  name        String
  level       Int     @default(0)

  org       Org                      @relation(fields: [org_id], references: [id])
  template  ProductCategoryTemplate? @relation(fields: [template_id], references: [id])
  parent    ProductCategory?         @relation("SubCategories", fields: [parent_id], references: [id])
  children  ProductCategory[]        @relation("SubCategories")
  products  Product[]
  discounts CategoryDiscount[]

  @@unique([org_id, parent_id, name])
  @@index([org_id])
}

model Brand {
  id       String    @id @default(uuid())
  org_id   String
  name     String

  org      Org       @relation(fields: [org_id], references: [id])
  products Product[]

  @@unique([org_id, name])
  @@index([org_id])
}

model Product {
  id            String   @id @default(uuid())
  org_id        String
  subcategoryid String
  brandid       String?
  supplier_id   String?
  barcode       String?
  SKU           String
  name          String
  createdat     DateTime @default(now())
  modifiedat    DateTime @updatedAt

  org      Org             @relation(fields: [org_id], references: [id])
  category ProductCategory @relation(fields: [subcategoryid], references: [id])
  brand    Brand?          @relation(fields: [brandid], references: [id])
  supplier Supplier?       @relation(fields: [supplier_id], references: [id])

  prices        ProductPrice[]
  discounts     ProductDiscount[]
  stock_batches StockBatch[]
  po_items      PurchaseOrderItem[]
  bill_items    BillItem[]

  @@unique([org_id, SKU])
  @@unique([org_id, barcode])
  @@index([org_id])
}

model ProductPrice {
  id            String    @id @default(uuid())
  productid     String
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("USD")
  effectivefrom DateTime  @default(now())
  effectiveto   DateTime?
  isdefault     Boolean   @default(false)

  product    Product    @relation(fields: [productid], references: [id])
  bill_items BillItem[]
}

// -----------------------------------------------------------------------------
// DISCOUNTS
// -----------------------------------------------------------------------------

model Discount {
  id           String    @id @default(uuid())
  org_id       String
  name         String
  type         String // E.g., PERCENTAGE, FIXED
  value        Decimal   @db.Decimal(10, 2)
  valid_from   DateTime  @default(now())
  valid_to     DateTime?
  min_qty      Int?
  min_val      Decimal?  @db.Decimal(10, 2)
  coup_code    String?
  is_active    Boolean   @default(true)
  is_stackable Boolean   @default(false)
  scope        String // E.g., PRODUCT, CATEGORY, ORDER

  org                Org                @relation(fields: [org_id], references: [id])
  product_discounts  ProductDiscount[]
  category_discounts CategoryDiscount[]

  @@unique([org_id, coup_code])
  @@index([org_id])
}

model ProductDiscount {
  product_id  String
  discount_id String
  priority    Int    @default(0)

  product  Product  @relation(fields: [product_id], references: [id])
  discount Discount @relation(fields: [discount_id], references: [id])

  @@id([product_id, discount_id])
}

model CategoryDiscount {
  category_id String
  discount_id String
  inherit     Boolean @default(true)

  category ProductCategory @relation(fields: [category_id], references: [id])
  discount Discount        @relation(fields: [discount_id], references: [id])

  @@id([category_id, discount_id])
}

// -----------------------------------------------------------------------------
// INVENTORY & SUPPLIERS
// -----------------------------------------------------------------------------

model InventoryLocation {
  id        String       @id @default(uuid())
  org_id    String
  name      String
  type      LocationType
  address   String?
  phone     String?
  is_active Boolean      @default(true)

  org            Org                    @relation(fields: [org_id], references: [id])
  user_locations UserLocation[]
  stock_batches  StockBatch[]
  stocks         InventoryStock[]
  transactions   InventoryTransaction[]
  pos            PurchaseOrder[]
  bills          Bill[]
}

model Supplier {
  id              String   @id @default(uuid())
  org_id          String
  name            String
  contact_person  String?
  phone           String?
  email           String?
  address         String?
  business_reg_no String?
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  org             Org                         @relation(fields: [org_id], references: [id])
  products        Product[]
  batches         StockBatch[]
  purchase_orders PurchaseOrder[]
  credit_accounts SupplierCreditAccount[]
  credit_txs      SupplierCreditTransaction[]
}

model PurchaseOrder {
  id                    String       @id @default(uuid())
  org_id                String
  supplier_id           String
  receiving_location_id String
  po_number             String
  status                POStatus     @default(DRAFT)
  payment_terms         PaymentTerms
  due_date              DateTime?
  total_amount          Decimal      @db.Decimal(12, 2)
  notes                 String?
  created_by            String
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  org        Org                         @relation(fields: [org_id], references: [id])
  supplier   Supplier                    @relation(fields: [supplier_id], references: [id])
  location   InventoryLocation           @relation(fields: [receiving_location_id], references: [id])
  creator    User                        @relation(fields: [created_by], references: [id])
  items      PurchaseOrderItem[]
  credit_txs SupplierCreditTransaction[]

  @@unique([org_id, po_number])
}

model PurchaseOrderItem {
  id                String       @id @default(uuid())
  po_id             String
  product_id        String
  quantity_ordered  Int
  quantity_received Int          @default(0)
  unit_cost         Decimal      @db.Decimal(10, 2)
  line_total        Decimal      @db.Decimal(12, 2)
  expiry_date       DateTime?
  status            POItemStatus @default(PENDING)
  notes             String?

  po      PurchaseOrder @relation(fields: [po_id], references: [id])
  product Product       @relation(fields: [product_id], references: [id])
  batches StockBatch[]
}

model StockBatch {
  id                      String    @id @default(uuid())
  product_id              String
  supplier_id             String?
  po_item_id              String?
  received_at_location_id String
  batch_number            String
  cost_price              Decimal   @db.Decimal(10, 2)
  selling_price           Decimal   @db.Decimal(10, 2)
  quantity_received       Int
  expiry_date             DateTime?
  received_at             DateTime  @default(now())
  created_by              String
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  product  Product            @relation(fields: [product_id], references: [id])
  supplier Supplier?          @relation(fields: [supplier_id], references: [id])
  po_item  PurchaseOrderItem? @relation(fields: [po_item_id], references: [id])
  location InventoryLocation  @relation(fields: [received_at_location_id], references: [id])
  creator  User               @relation(fields: [created_by], references: [id])

  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  bill_items   BillItem[]
}

model InventoryStock {
  id               String   @id @default(uuid())
  batch_id         String
  location_id      String
  quantity_on_hand Int      @default(0)
  reorder_point    Int      @default(0)
  updated_at       DateTime @updatedAt

  batch    StockBatch        @relation(fields: [batch_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])

  @@unique([batch_id, location_id])
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  batch_id         String
  location_id      String
  transaction_type InventoryTransactionType
  quantity_change  Int
  reference_id     String?
  reference_type   String?
  notes            String?
  recorded_by      String
  created_at       DateTime                 @default(now())

  batch    StockBatch        @relation(fields: [batch_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])
  recorder User              @relation(fields: [recorded_by], references: [id])
}

// -----------------------------------------------------------------------------
// SUPPLIER CREDIT
// -----------------------------------------------------------------------------

model SupplierCreditAccount {
  id              String        @id @default(uuid())
  supplier_id     String        @unique
  org_id          String
  credit_limit    Decimal?      @db.Decimal(12, 2)
  current_balance Decimal       @default(0.00) @db.Decimal(12, 2)
  status          AccountStatus @default(ACTIVE)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  supplier Supplier @relation(fields: [supplier_id], references: [id])
  org      Org      @relation(fields: [org_id], references: [id])
}

model SupplierCreditTransaction {
  id               String                  @id @default(uuid())
  supplier_id      String
  org_id           String
  po_id            String?
  transaction_type SupplierTransactionType
  amount           Decimal                 @db.Decimal(12, 2)
  balance_after    Decimal                 @db.Decimal(12, 2)
  due_date         DateTime?
  paid_at          DateTime?
  reference_no     String?
  notes            String?
  recorded_by      String
  created_at       DateTime                @default(now())

  supplier       Supplier       @relation(fields: [supplier_id], references: [id])
  org            Org            @relation(fields: [org_id], references: [id])
  purchase_order PurchaseOrder? @relation(fields: [po_id], references: [id])
  recorder       User           @relation(fields: [recorded_by], references: [id])
}

// -----------------------------------------------------------------------------
// CUSTOMERS & LOYALTY
// -----------------------------------------------------------------------------

model Customer {
  id                String    @id @default(uuid())
  org_id            String
  full_name         String
  phone             String
  email             String?
  address           String?
  notes             String?
  customer_type     String?
  sms_opt_out       Boolean   @default(false)
  is_loyalty_member Boolean   @default(false)
  loyalty_points    Int       @default(0)
  total_spent       Decimal   @default(0.00) @db.Decimal(12, 2)
  total_visits      Int       @default(0)
  first_visit_at    DateTime?
  last_visit_at     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  org            Org                          @relation(fields: [org_id], references: [id])
  credit_account CustomerCreditAccount?
  credit_txs     CustomerCreditTransaction[]
  loyalty_txs    CustomerLoyaltyTransaction[]
  bills          Bill[]

  @@unique([org_id, phone])
}

model CustomerCreditAccount {
  id              String        @id @default(uuid())
  customer_id     String        @unique
  org_id          String
  credit_limit    Decimal?      @db.Decimal(12, 2)
  current_balance Decimal       @default(0.00) @db.Decimal(12, 2)
  status          AccountStatus @default(ACTIVE)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id])
  org      Org      @relation(fields: [org_id], references: [id])
}

model CustomerCreditTransaction {
  id               String                  @id @default(uuid())
  customer_id      String
  org_id           String
  bill_id          String?
  recorded_by      String
  transaction_type CustomerTransactionType
  amount           Decimal                 @db.Decimal(12, 2)
  balance_after    Decimal                 @db.Decimal(12, 2)
  notes            String?
  created_at       DateTime                @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
  org      Org      @relation(fields: [org_id], references: [id])
  bill     Bill?    @relation(fields: [bill_id], references: [id])
  recorder User     @relation(fields: [recorded_by], references: [id])
}

model CustomerLoyaltyTransaction {
  id                   String                 @id @default(uuid())
  customer_id          String
  org_id               String
  bill_id              String
  transaction_type     LoyaltyTransactionType
  points               Int
  points_balance_after Int
  notes                String?
  created_at           DateTime               @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
  org      Org      @relation(fields: [org_id], references: [id])
  bill     Bill     @relation(fields: [bill_id], references: [id])
}

model LoyaltyProgramConfig {
  id                    String   @id @default(uuid())
  org_id                String   @unique
  is_active             Boolean  @default(true)
  points_per_rupee      Decimal  @db.Decimal(8, 2)
  min_points_to_redeem  Int      @default(0)
  rupee_value_per_point Decimal  @db.Decimal(8, 2)
  points_expiry_days    Int?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  org Org @relation(fields: [org_id], references: [id])
}

// -----------------------------------------------------------------------------
// SALES & BILLING
// -----------------------------------------------------------------------------

model Bill {
  id             String     @id @default(uuid())
  org_id         String
  location_id    String
  customer_id    String?
  cashier_id     String
  bill_number    String
  status         BillStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discount_total Decimal    @db.Decimal(12, 2)
  tax_total      Decimal    @db.Decimal(12, 2)
  grand_total    Decimal    @db.Decimal(12, 2)
  amount_paid    Decimal    @db.Decimal(12, 2)
  change_given   Decimal    @db.Decimal(12, 2)
  notes          String?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  org      Org               @relation(fields: [org_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])
  customer Customer?         @relation(fields: [customer_id], references: [id])
  cashier  User              @relation("CashierBills", fields: [cashier_id], references: [id])

  items       BillItem[]
  payments    BillPayment[]
  credit_txs  CustomerCreditTransaction[]
  loyalty_txs CustomerLoyaltyTransaction[]

  @@unique([org_id, bill_number])
}

model BillItem {
  id              String  @id @default(uuid())
  bill_id         String
  product_id      String
  batch_id        String?
  price_id        String?
  quantity        Int
  unit_price      Decimal @db.Decimal(10, 2)
  discount_amount Decimal @default(0.00) @db.Decimal(10, 2)
  line_total      Decimal @db.Decimal(12, 2)
  notes           String?

  bill    Bill          @relation(fields: [bill_id], references: [id])
  product Product       @relation(fields: [product_id], references: [id])
  batch   StockBatch?   @relation(fields: [batch_id], references: [id])
  price   ProductPrice? @relation(fields: [price_id], references: [id])
}

model BillPayment {
  id             String        @id @default(uuid())
  bill_id        String
  payment_method PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  reference_no   String?
  paid_at        DateTime      @default(now())
  recorded_by    String

  bill     Bill @relation(fields: [bill_id], references: [id])
  recorder User @relation(fields: [recorded_by], references: [id])
}
